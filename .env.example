# Endereço público da carteira do experimento. Não coloque chave privada aqui.
HOT_WALLET_ADDRESS=GNJv4FcMb4j1A6NFiVaaHkGVTZ5p5A7ea9GsFgccS75r

# Caminho local do keypair JSON (solana-keygen). Só existe na máquina do operador.
SOLANA_KEYPAIR_PATH=

# 1 envia swap na Jupiter. Qualquer outro valor fica em dry-run.
LIVE_TRADING=0

# von serve --model von-1.2 --port 8000
VON_BASE_URL=http://127.0.0.1:8000
VON_MODEL=von-latest
VON_TIMEOUT_S=8

# Portões e tamanhos vêm de config/params.json: defaults + profiles.<PARAMS_PROFILE>.
#   relaxed_paper (padrão): confiança >= 0.35 E margem de probabilidade >= 0.20, skip < 0.5 (portão relaxed do lab; só paper)
#   article: confiança >= 0.55, skip < 0.55 (artigo)
# Um perfil paper_only nunca vale com LIVE_TRADING=1 (cai no article).
PARAMS_PROFILE=relaxed_paper
PARAMS_PATH=config/params.json

# Sobreposições antigas (opcionais): se definidas, ganham ao perfil. Deixe comentadas para usar o perfil.
# CONFIDENCE_THRESHOLD=0.55
# SKIP_THRESHOLD=0.55
# PROB_MARGIN_MIN=0
# LOOP_SECONDS=15

# Tamanho humano, depois multiplicado pela confiança. Tetos evitam esvaziar a carteira num ciclo.
# (padrões no perfil; descomente para sobrepor)
# BUY_USDT=1
# SELL_SOL=0.005
# MAX_BUY_USDT=5
# MAX_SELL_SOL=0.01

JUPITER_ULTRA_BASE=https://lite-api.jup.ag
JUPITER_QUOTE_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
LOG_DIR=logs

# Paper trading (dry-run): custo contra o trader, em pontos-base sobre o px_in (slippage + fee). Padrão no perfil.
# PAPER_COST_BPS=10
# Início do run corrente (run_id, start_t, livro, preço de referência).
EXPERIMENT_PATH=config/experiment.json
# Critérios aprovados pela reescrita noturna. Ausente ou inválido → frases do artigo.
CRITERIA_PATH=config/criteria.json
